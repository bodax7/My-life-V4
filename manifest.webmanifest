{
  "name": "حياتي — MyLife",
  "short_name": "حياتي",
  "description": "إدارة مالية البيت والحياة اليومية",
  "lang": "ar",
  "dir": "rtl",
  "start_url": "./#/home",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f3f5f4",
  "theme_color": "#0f3d3e",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "image",
          "accept": [
            "image/*"
          ]
        }
      ]
    }
  },
  "shortcuts": [
    {
      "name": "مصروف جديد",
      "short_name": "مصروف",
      "url": "./#/quick?a=expense",
      "icons": [
        {
          "src": "sc-expense.png",
          "sizes": "192x192",
          "type": "image/png",
          "purpose": "any"
        }
      ]
    },
    {
      "name": "دخل جديد",
      "short_name": "دخل",
      "url": "./#/quick?a=income",
      "icons": [
        {
          "src": "sc-income.png",
          "sizes": "192x192",
          "type": "image/png",
          "purpose": "any"
        }
      ]
    },
    {
      "name": "ملاحظة جديدة",
      "short_name": "ملاحظة",
      "url": "./#/quick?a=note",
      "icons": [
        {
          "src": "sc-note.png",
          "sizes": "192x192",
          "type": "image/png",
          "purpose": "any"
        }
      ]
    },
    {
      "name": "الآلة الحاسبة",
      "short_name": "الحاسبة",
      "url": "./#/quick?a=calc",
      "icons": [
        {
          "src": "sc-calc.png",
          "sizes": "192x192",
          "type": "image/png",
          "purpose": "any"
        }
      ]
    }
  ]
}